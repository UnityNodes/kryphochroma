(kryphochroma_upstream) {
	flush_interval -1
	lb_try_duration 20s
	lb_try_interval 250ms
}

kryphochroma.unitynodes.com {
	encode gzip
	tls /etc/ssl/cf-origin-unitynodes.pem /etc/ssl/cf-origin-unitynodes-key.pem

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	@static path /_next/static/* /fonts/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	@api path /api/*
	request_body @api {
		max_size 8KB
	}

	@via_cf {
		header Cf-Connecting-Ip *
		remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	reverse_proxy @via_cf 127.0.0.1:3310 {
		header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
		import kryphochroma_upstream
	}
	reverse_proxy 127.0.0.1:3310 {
		header_up X-Forwarded-For {remote_host}
		import kryphochroma_upstream
	}
}
